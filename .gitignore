# ── Dependencies ────────────────────────────────────────────
node_modules/

# ── Production build output (generated by `npm run build`) ──
dist/
build/

# ── Environment files — NEVER commit real secrets ──────────
.env
.env.*
!.env.example

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Cloudflare / Wrangler local state ───────────────────────
.wrangler/
.dev.vars
.dev.vars.*

# ── Editor & OS junk ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── TypeScript incremental cache ────────────────────────────
*.tsbuildinfo

# ── Package manager noise ───────────────────────────────────
.pnp/
.pnp.js
.yarn/
