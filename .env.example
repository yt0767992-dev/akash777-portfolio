# ============================================================================
# Environment variables — TEMPLATE ONLY (safe to commit)
#
# How to use:
#   1. Copy this file:  copy .env.example .env
#   2. Fill in real values in .env  (the .env file is git-ignored)
#   3. On Cloudflare Pages: add the same keys under
#      Settings → Environment variables → Production
#
# ⚠️  SECURITY RULES
#   • NEVER put passwords, private API keys, tokens or secrets in any
#     variable starting with VITE_. Vite inlines VITE_* values into the
#     public JavaScript bundle — anyone can read them in the browser.
#   • Only public configuration (URLs, public IDs) belongs here.
#   • .env is listed in .gitignore and must never be uploaded to GitHub.
# ============================================================================

# Public base URL of the backend/API.
# Leave empty while the site runs as a static frontend with no backend.
# Example (Cloudflare Worker): VITE_API_BASE_URL=https://api.YOUR-SUBDOMAIN.workers.dev
VITE_API_BASE_URL=

# Public URL of the deployed website (used for SEO / canonical links).
# Example: VITE_SITE_URL=https://akash777-portfolio.pages.dev
VITE_SITE_URL=
